# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dashboard_autocarros?schema=public"

# Server
PORT=3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@guidedportugal.tech
EMAIL_TO=recipient@example.com
FRONTEND_URL=https://guidedportugal.tech

# Alert Configuration
ALERT_DAYS_BEFORE=30

# Encryption Key (para encriptar passwords SMTP)
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-key-here

# Environment
NODE_ENV=development



